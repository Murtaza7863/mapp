# Web Push — both values are public and end up in the client bundle.
# The matching private key is a Cloudflare Worker secret, never stored here.
#
# Generate a pair with:  cd worker && npm run keys
# Then set the same public key on the Pages build (GitHub repository variables).
VITE_PUSH_API_URL=https://mapp-push.YOUR_SUBDOMAIN.workers.dev
VITE_VAPID_PUBLIC_KEY=YOUR_BASE64URL_PUBLIC_KEY
